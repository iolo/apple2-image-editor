{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apple2-image-editor",
  "version": "1.0.0",
  "identifier": "kr.iolo.apple2-image-editor",
  "build": {
    "beforeDevCommand": "npm run dev:desktop-web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop-web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "apple2-image-editor",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Simple image editor for Apple II"
  }
}
